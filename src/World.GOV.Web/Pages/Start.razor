@page "/start"
@inject PortalDataService Data

<PageTitle>@T("Start exploring") · World.GOV</PageTitle>

<section class="page-intro"><p class="eyebrow">@T("A SHORT TOUR OF THE PUBLIC RECORD")</p><h1>@T("History has a change log.")</h1><p>@T("Follow four Danish milestones. Read what happened, inspect the evidence, and discover the fictional administrative response.")</p></section>

@if (Current is not null)
{
    <nav class="journey-steps" aria-label="@T("Tour chapters")">
        @for (var i = 0; i < Entries.Count; i++)
        {
            <a href="@($"start?step={i + 1}")" aria-current="@(i == Index ? "step" : null)" class="@(i == Index ? "current" : "")"><span>@(i + 1)</span>@Entries[i].Date.StartYear?.ToString("D4")</a>
        }
    </nav>
    <article class="panel journey-card" aria-live="polite">
        <p class="eyebrow">@T("CHAPTER") @(Index + 1) @T("OF") @Entries.Count · @Current.Date</p>
        <h2>@IncidentLocalization.Title(Current, SelectedLocale)</h2>
        <p class="fact-summary">@IncidentLocalization.Summary(Current, SelectedLocale)</p>
        <div class="notice notice-info"><strong>@T("Fictional administrative memo")</strong><span>@IncidentLocalization.PublicSummary(Current, SelectedLocale)</span></div>
        <a class="button-primary" href="@($"incident/{Current.Id}")">@T("Read the evidence & code joke →")</a>
        <details class="reflection"><summary>@T("Pause for a moment")</summary><p>@T("What changed in this event? Which part of this page is supported by the source, and which part was invented for the joke?")</p><p>@T("The historical account is the paragraph above the memo. The memo is fictional. Follow the incident link to check the original source.")</p></details>
    </article>
    <nav class="pagination" aria-label="@T("Tour navigation")">
        @if (Index > 0) { <a class="button-secondary" href="@($"start?step={Index}")">@T("← Previous chapter")</a> }
        @if (Index < Entries.Count - 1) { <a class="button-primary" href="@($"start?step={Index + 2}")">@T("Next chapter →")</a> }
        else { <a class="button-primary" href="history">@T("Continue into the timeline →")</a> }
    </nav>
}
else
{
    <p role="status">@(Ready ? T("The introductory records are not available in this publication.") : T("Loading the tour…"))</p>
    <a href="incidents">@T("Browse available incidents")</a>
}

@code {
    private string T(string english, params object?[] args) => Data.Translate(english, SelectedLocale, args);
    [SupplyParameterFromQuery(Name = "step")] public int? Step { get; set; }
    [CascadingParameter] public string SelectedLocale { get; set; } = "en-US";
    private bool Ready;
    private IReadOnlyList<GovernmentIncident> Entries => Data.GetIncidentsByCountry("DK").Where(item => item.Tags.Contains("starter-tour", StringComparer.OrdinalIgnoreCase)).OrderBy(item => item.Date).ToArray();
    private int Index => Math.Clamp((Step ?? 1) - 1, 0, Math.Max(0, Entries.Count - 1));
    private GovernmentIncident? Current => Entries.Count > 0 ? Entries[Index] : null;
    protected override async Task OnInitializedAsync() { await Data.EnsureLoadedAsync(); Ready = true; }
}
