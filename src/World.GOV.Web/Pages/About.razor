@page "/about"
@inject PortalDataService Data

<PageTitle>@T("About") · World.GOV</PageTitle>

<section class="page-intro"><p class="eyebrow">@T("ABOUT THE PROJECT")</p><h1>Clean code. Broken politics.</h1><p>@T("World.GOV is a historical discovery experience, a programming joke, and an open-source engineering project.")</p></section>

<div class="content-grid about-grid">
    <section class="panel"><p class="eyebrow">@T("PURPOSE")</p><h2>@T("History remains the source of truth.")</h2><p>@T("Every incident keeps its factual account, evidence status, and citations separate from its fictional commit messages and GOV diagnostics. A joke is never used as evidence.")</p><p>@T("The project uses a data-first country contract. Denmark is the reference module; other countries can contribute independent records through the same manifest format.")</p></section>
    <section class="panel"><p class="eyebrow">@T("CONTRIBUTING")</p><h2>@T("Small, sourced changes are welcome.")</h2><ul class="plain-list"><li>@T("Support factual claims with credible sources.")</li><li>@T("Keep interpretation and fictional satire clearly labeled.")</li><li>@T("Do not invent quotations or make unsourced personal accusations.")</li><li>@T("Run the validator and build before submitting.")</li></ul>@if (Data.Manifest?.RepositoryUrl is string repositoryUrl){<a class="text-link" href="@repositoryUrl" target="_blank" rel="noopener noreferrer">@T("Open the project repository") <span aria-hidden="true">↗</span></a>}else{<p class="muted">@T("Repository link is published with the GitHub Pages build.")</p>}</section>
</div>

<section class="notice notice-info about-notice" lang="en" dir="ltr"><strong>Engineering rule</strong><span>Actual compiler failures fail the build. GOV-domain satire remains a separate report and cannot turn a failing build green.</span></section>

<div class="content-grid about-grid">
    <section class="panel" id="evidence"><p class="eyebrow">@T("HOW TO READ THE RECORD")</p><h2>@T("Evidence, explained")</h2><dl class="evidence-definitions">
        <dt>@T("Documented")</dt><dd>@T("The cited material directly supports the account. This does not mean every interpretation is settled.")</dd>
        <dt>@T("Interpretive")</dt><dd>@T("A stated explanation or connection is attributed to an author. Read the accompanying note for its limits.")</dd>
        <dt>@T("Uncertain")</dt><dd>@T("The date, attribution, or another material detail cannot be established precisely. The note says what is unknown.")</dd>
        <dt>@T("Disputed")</dt><dd>@T("Credible accounts disagree. The note describes the disagreement and identifies the sources.")</dd>
    </dl><p>@T("These are descriptions of evidence, not numerical confidence scores. Memo text, GOV diagnostics, and simulation commits are fictional.")</p></section>
    <section class="panel" id="corrections"><p class="eyebrow">@T("CORRECTIONS & CONTRIBUTIONS")</p><h2>@T("The record can be corrected.")</h2><p>@T("Report the incident ID, the exact statement, and a source supporting your proposed correction. A maintainer reviews the evidence and records factual changes in the changelog. Historical dates stay unchanged when the record is edited.")</p>
    @if (Data.Manifest?.RepositoryUrl is string correctionRepo)
    {
        <a class="button-primary" href="@($"{correctionRepo}/issues/new?template=correction.yml")" target="_blank" rel="noopener noreferrer">@T("Report a correction ↗")</a>
    }
    else
    {
        <p>@T("This local preview has no connected issue tracker. Add a proposed correction to the repository with the incident ID and supporting source; the published site links to GitHub issues.")</p>
    }
    <p>@T("Original project code and writing use the MIT license. Linked archives and publications retain their own terms. No account or tracking analytics are used by this portal.")</p></section>
</div>

<section class="panel" id="translations">
    <p class="eyebrow">@T("HELP TRANSLATE")</p>
    <h2>@T("Translate the public portal")</h2>
    <p>@T("English is the default. Community translations can be partial; missing text stays in English. Developer view, code, diagnostics, simulated commits, and GOV standards always stay in English.")</p>
    <ul class="plain-list">
        @foreach (var locale in Data.WebsiteLocales)
        {
            <li><strong>@locale.NativeName</strong> · @Data.TranslatedStringCount(locale) / @(Data.WebsiteLocales.FirstOrDefault(item => item.Locale == "en-US")?.Strings.Count ?? 0) @T("Website text")</li>
        }
    </ul>
    @if (Data.GetSourceCodeUrl("docs/contributing/translations.md") is string translationGuide)
    {
        <a class="text-link" href="@translationGuide" target="_blank" rel="noopener noreferrer">@T("Read the translation guide →")</a>
    }
    else
    {
        <p class="muted">@T("Translation guide: docs/contributing/translations.md in the repository.")</p>
    }
</section>

@code {
    private string T(string english, params object?[] args) => Data.Translate(english, SelectedLocale, args);
    [CascadingParameter] public string SelectedLocale { get; set; } = "en-US";
    protected override Task OnInitializedAsync() => Data.EnsureLoadedAsync();
}
