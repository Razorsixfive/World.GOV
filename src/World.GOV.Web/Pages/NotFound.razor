@page "/not-found"
@inject PortalDataService Data

<PageTitle>@T("Page not found") · World.GOV</PageTitle>
<section class="page-intro">
    <p class="eyebrow">@T("ROUTE REGISTRY")</p>
    <h1>@T("Page not found")</h1>
    <p>@T("The requested route is not in the current publication manifest.")</p>
    <a class="button-primary" href="">@T("Return to overview")</a>
</section>

@code {
    private string T(string english, params object?[] args) => Data.Translate(english, SelectedLocale, args);
    [CascadingParameter] public string SelectedLocale { get; set; } = "en-US";
}
