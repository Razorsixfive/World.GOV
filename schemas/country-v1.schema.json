{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World.GOV country manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "displayName",
    "nativeName",
    "defaultLocale",
    "supportedLocales",
    "historicalCoverage",
    "incidentFiles",
    "standardFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z]{2,3}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "nativeName": { "type": "string", "minLength": 1 },
    "defaultLocale": { "type": "string", "minLength": 2 },
    "supportedLocales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "historicalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startYear", "endYear"],
      "properties": {
        "startYear": { "type": ["integer", "null"], "minimum": -9999, "maximum": 9999, "not": { "const": 0 } },
        "endYear": { "type": ["integer", "null"], "minimum": -9999, "maximum": 9999, "not": { "const": 0 } }
      }
    },
    "incidentFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "standardFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "extensionAssembly": { "type": ["string", "null"] }
  }
}
